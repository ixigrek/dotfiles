# Fonctions `use` de direnv, chargées avant chaque .envrc.
# Elles s'exécutent dans le bash de direnv, pas dans zsh : syntaxe bash.
#
# Objectif : le contexte cloud vit dans le dépôt, pas dans le shell. On entre
# dans gcloud/project-a, la configuration gcloud du projet devient active ;
# on en sort, plus aucun provider n'est actif — ni dans le prompt (starship
# ne rend ces modules que si la variable est posée, cf.
# ~/.config/starship.toml) ni pour les CLI.
#
# Chaque .envrc doit être autorisé une fois : `direnv allow`.

# use gcloud <configuration>
#
# Bascule la configuration gcloud active pour ce shell uniquement, via
# CLOUDSDK_ACTIVE_CONFIG_NAME — `gcloud config configurations activate`, lui,
# est global (il réécrit ~/.config/gcloud/active_config). Le magasin de
# credentials reste partagé : un seul `gcloud auth login` pour tout le monde,
# seuls project/account/région changent d'une configuration à l'autre.
#
# Créer la configuration une fois :
#   gcloud config configurations create <nom>
#   gcloud config set project <projet>   # depuis le dossier, une fois le .envrc chargé
use_gcloud() {
  local cfg="$1"
  local root="${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}"

  if [[ -z "$cfg" ]]; then
    log_error "use gcloud: nom de configuration manquant"
    return 1
  fi
  if [[ ! -f "$root/configurations/config_$cfg" ]]; then
    log_error "use gcloud: configuration '$cfg' inconnue — gcloud config configurations create $cfg"
    return 1
  fi

  # Le test ci-dessus ne porte que sur l'existence du fichier : une
  # configuration créée mais jamais renseignée le passerait sans bruit, et
  # chaque commande gcloud réclamerait ensuite un projet — pendant que le
  # prompt afficherait un symbole nu, faute de project à rendre.
  # Le réglage se fait avec la variable en préfixe : le .envrc ayant échoué,
  # elle n'est pas dans l'environnement.
  if ! grep -qE '^[[:space:]]*project[[:space:]]*=' "$root/configurations/config_$cfg"; then
    log_error "use gcloud: configuration '$cfg' sans project — CLOUDSDK_ACTIVE_CONFIG_NAME=$cfg gcloud config set project <projet>"
    return 1
  fi

  # Le prompt affiche le project lu dans ce fichier : direnv doit recharger
  # quand il change (gcloud config set project).
  watch_file "$root/configurations/config_$cfg"
  export CLOUDSDK_ACTIVE_CONFIG_NAME="$cfg"
}

# use azure <profil>
#
# az n'a pas d'équivalent des configurations nommées de gcloud : le seul
# cloisonnement possible est un répertoire de config par profil, tokens
# compris. Le premier appel recopie la session courante de ~/.azure pour
# éviter un nouveau `az login` ; ensuite le profil vit sa vie
# (`az account set -s <abonnement>` n'affecte que lui).
use_azure() {
  local profile="$1"
  local dir="$HOME/.azure-profiles/$profile"

  if [[ -z "$profile" ]]; then
    log_error "use azure: nom de profil manquant"
    return 1
  fi

  if [[ ! -d "$dir" ]]; then
    mkdir -p "$dir"

    # Amorçage : on recopie une session déjà ouverte plutôt que d'imposer un
    # `az login` de plus. ~/.azure est la session de référence ; le
    # répertoire neutre sert de repli, c'est là qu'atterrit un `az login`
    # lancé hors projet (cf. ~/.zsh/60-tools.zsh).
    local src f seeded=""
    for src in "$HOME/.azure" "$HOME/.azure-profiles/none"; do
      if [[ -f "$src/msal_token_cache.json" ]]; then
        for f in azureProfile.json msal_token_cache.json service_principal_entries.json clouds.config config; do
          if [[ -e "$src/$f" ]]; then
            cp -p "$src/$f" "$dir/"
          fi
        done
        seeded="$src"
        break
      fi
    done

    if [[ -n "$seeded" ]]; then
      log_status "azure: profil '$profile' amorcé depuis $seeded — az account set -s <abonnement>"
    else
      log_status "azure: profil '$profile' créé dans $dir — az login"
    fi
  fi

  # L'abonnement affiché vient de ce fichier.
  watch_file "$dir/azureProfile.json"
  export AZURE_CONFIG_DIR="$dir"
}

# use aws <profil> [région]
#
# AWS_PROFILE est déjà une variable par shell, il n'y a rien à cloisonner :
# il suffit de la poser. Le prompt l'affiche telle quelle (module env_var),
# donc pas de profil exporté = pas d'affichage.
use_aws() {
  local profile="$1" region="$2"
  local cfg="${AWS_CONFIG_FILE:-$HOME/.aws/config}"

  if [[ -z "$profile" ]]; then
    log_error "use aws: nom de profil manquant"
    return 1
  fi
  if [[ -f "$cfg" ]] && ! grep -qE "^\[(profile )?${profile}\]" "$cfg"; then
    log_error "use aws: profil '$profile' absent de $cfg"
    return 1
  fi

  export AWS_PROFILE="$profile"
  if [[ -n "$region" ]]; then
    export AWS_REGION="$region"
    export AWS_DEFAULT_REGION="$region"
  fi
}

# use kube <contexte> [namespace]
#
# `kubectl config use-context` est global, et c'est le pire des quatre : il
# réécrit le current-context de ~/.kube/config, donc celui de tous les
# terminaux déjà ouverts. Rien ne le signale, et le `kubectl delete` suivant
# part sur le cluster d'à côté.
#
# KUBECONFIG accepte une liste de fichiers fusionnés, où le premier gagne pour
# chaque entrée. On glisse donc devant ~/.kube/config un fichier de
# recouvrement qui ne porte que la sélection du dépôt : le contexte actif, et
# une copie de sa définition — les *noms* de cluster et de user, pas les
# credentials, qui restent dans ~/.kube/config. Un seul `get-credentials`
# alimente ainsi tous les dépôts, comme un seul `gcloud auth login`.
#
# Recopier le contexte plutôt que le seul current-context n'est pas un excès de
# zèle : `kubectl config` écrit dans le fichier où l'entrée modifiée est
# *définie*. Sans cette copie, `set-context --current --namespace=x` (kubens et
# consorts) irait écrire le namespace du dépôt dans ~/.kube/config, où il
# vaudrait pour tout le monde. Avec elle, les deux commandes qui basculent quoi
# que ce soit n'atteignent que le recouvrement :
#   - `use-context` écrit dans le premier fichier portant un current-context ;
#   - `set-context` écrit là où le contexte est défini.
#
# Le recouvrement est reconstruit depuis les arguments à chaque chargement : le
# .envrc est la source de vérité. Une bascule faite à la main tient donc le
# temps de la session, et sortir/rentrer dans le dossier rétablit le contexte
# du dépôt.
use_kube() {
  local ctx="$1" ns="$2"
  local base="${KUBECONFIG:-$HOME/.kube/config}"
  local main="${base%%:*}"
  local dir="$HOME/.kube/direnv"

  if [[ -z "$ctx" ]]; then
    log_error "use kube: nom de contexte manquant"
    return 1
  fi
  if ! has kubectl; then
    log_error "use kube: kubectl introuvable — brew install kubernetes-cli"
    return 1
  fi
  if [[ ! -f "$main" ]]; then
    log_error "use kube: aucun kubeconfig dans $main — <cloud> get-credentials, depuis ~"
    return 1
  fi

  # Un seul appel à kubectl : le .envrc est rejoué à chaque cd dans le dossier.
  # Et un contexte absent doit être refusé ici — sinon rien ne bronche au
  # chargement, le prompt affiche tranquillement le nom d'un cluster
  # inatteignable, et l'erreur ne sort qu'à la première commande.
  local cluster user gns
  { read -r cluster; read -r user; read -r gns; } < <(
    KUBECONFIG="$base" kubectl config view -o \
      "jsonpath={range .contexts[?(@.name=='$ctx')]}{.context.cluster}{\"\n\"}{.context.user}{\"\n\"}{.context.namespace}{\"\n\"}{end}" 2>/dev/null
  )
  if [[ -z "$cluster" ]]; then
    log_error "use kube: contexte '$ctx' inconnu — kubectl config get-contexts"
    return 1
  fi
  # Sans namespace demandé, on reconduit celui du contexte d'origine : la copie
  # masque l'entrée globale, ne pas le reporter le remplacerait par "default".
  ns="${ns:-$gns}"

  local content="apiVersion: v1
kind: Config
current-context: $ctx
contexts:
- name: $ctx
  context:
    cluster: $cluster
    user: $user${ns:+
    namespace: $ns}
"

  # Nom de fichier assaini : les contextes EKS sont des ARN (`arn:aws:eks:...`,
  # avec des `/`), et `:` est justement le séparateur de KUBECONFIG.
  local key="${ctx}${ns:+@$ns}"
  local overlay="$dir/${key//[^A-Za-z0-9._@-]/_}.yaml"

  mkdir -p "$dir"
  # Le recouvrement est partagé par les dépôts qui demandent le même couple
  # contexte/namespace ; comme il est entièrement dérivé des arguments, le
  # reconstruire est idempotent. On ne réécrit que s'il a bougé — une bascule
  # faite à la main, typiquement.
  if [[ ! -f "$overlay" || "$(cat "$overlay")" != "$content" ]]; then
    printf '%s' "$content" > "$overlay"
  fi

  # cluster, user et namespace sont recopiés d'ici : si le kubeconfig principal
  # change (get-credentials, rotation), le recouvrement doit être refait.
  watch_file "$main"
  export KUBECONFIG="$overlay:$base"
}
