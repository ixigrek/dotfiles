theme	= Gruvbox Material

# Police Nerd Font : le prompt starship, les barres zjstatus et les icônes de
# neovim sont écrits en glyphs Nerd Font. Sans cette ligne ghostty retombe sur
# SF Mono, qui ne les a pas — les icônes deviennent des tofus.
# Variante "Mono" : glyphs contraints à une cellule, sinon ils débordent sur
# la colonne suivante et décalent tout ce qui suit dans les barres.
font-family = "JetBrainsMono Nerd Font Mono"

macos-option-as-alt = left
keybind = alt+left=unbind
keybind = alt+right=unbind

background-opacity = 0.25
background-blur = macos-glass-regular
