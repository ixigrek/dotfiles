# --- Homebrew en premier : tout le reste en dépend ---
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

export HOMEBREW_NO_REQUIRE_TAP_TRUST=1

# --- oh-my-zsh ---
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="bureau"
plugins=(git)
[ -f "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# --- plugins zsh (brew) ---
if command -v brew >/dev/null 2>&1; then
  BREW_PREFIX="$(brew --prefix)"
  for p in zsh-syntax-highlighting zsh-autosuggestions zsh-vi-mode; do
    f="$BREW_PREFIX/share/$p/$p.zsh"
    [ -f "$f" ] || f="$BREW_PREFIX/share/$p/$p.plugin.zsh"
    [ -f "$f" ] && source "$f"
  done
fi

# --- PATH ---
export PATH="$HOME/.local/bin:$PATH"
[ -d "/opt/homebrew/opt/ffmpeg-full/bin" ] && \
  export PATH="/opt/homebrew/opt/ffmpeg-full/bin:$PATH"

# --- Go ---
export GOPATH="$HOME/go"
if command -v brew >/dev/null 2>&1 && brew --prefix golang >/dev/null 2>&1; then
  export GOROOT="$(brew --prefix golang)/libexec"
  export PATH="$PATH:$GOROOT/bin"
fi
export PATH="$PATH:$GOPATH/bin"

# --- complétions ---
fpath=($HOME/.zfunc $fpath)
autoload -Uz compinit && compinit

# --- zellij en dernier (exec remplace le shell) ---
if [[ -o interactive ]] && [[ -z "$ZELLIJ" ]] && [[ -z "$NO_ZELLIJ" ]] \
   && command -v zellij >/dev/null; then
  exec zellij
fi
