# Toute la configuration vit dans ~/.zsh/, chargée dans l'ordre lexical.
# Le préfixe numérique encode les dépendances :
#
#   00-path       Homebrew + PATH (tout le reste en dépend)
#   10-completion fpath, avant le compinit d'oh-my-zsh
#   20-omz        oh-my-zsh (lance compinit)
#   30-plugins    plugins brew, après compinit, fzf-tab en tête
#   40-theme      palette Gruvbox Material, FZF_DEFAULT_OPTS, LS_COLORS
#   50-fzf-tab    zstyles fzf-tab, dépend de 40
#   60-tools      bashcompinit (terraform, packer, terragrunt, gcloud), direnv, zoxide
#   70-prompt     starship, doit passer après le chargement d'oh-my-zsh
#   90-zellij     exec zellij, doit rester en dernier
#
# ~/.zsh/bin/regen-completions audite les complétions et comble les trous
# dans ~/.zfunc (la plupart viennent déjà des site-functions de brew).
#
# Ajouts locaux / machine : ~/.zsh/80-local.zsh — surtout pas 9x, qui
# passerait après l'exec de 90-zellij et ne s'exécuterait jamais.
for _zf in "$HOME"/.zsh/*.zsh(N.); do
  source "$_zf"
done
unset _zf
