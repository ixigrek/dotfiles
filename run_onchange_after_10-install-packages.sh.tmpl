#!/bin/bash
# Brewfile hash: {{ include "dot_Brewfile" | sha256sum }}
set -eufo pipefail

if ! command -v brew >/dev/null 2>&1; then
  echo "==> Installation de Homebrew"
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

export HOMEBREW_NO_REQUIRE_TAP_TRUST=1
echo "==> brew bundle"
brew bundle --file="{{ .chezmoi.homeDir }}/.Brewfile"

echo "==> complétions zsh"
mkdir -p "{{ .chezmoi.homeDir }}/.zfunc"

if command -v pass-cli >/dev/null 2>&1; then
  pass-cli completions zsh > "{{ .chezmoi.homeDir }}/.zfunc/_pass-cli"
fi

if command -v talosctl >/dev/null 2>&1; then
  talosctl completion zsh > "{{ .chezmoi.homeDir }}/.zfunc/_talosctl"
fi

rm -f "{{ .chezmoi.homeDir }}/.zcompdump"
